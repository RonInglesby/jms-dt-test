<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:solace-tracing="http://www.mulesoft.org/schema/mule/solace-tracing"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/solace-tracing http://www.mulesoft.org/schema/mule/solace-tracing/current/mule-solace-tracing.xsd">

	<!-- The listener acks when the flow succeeds and asks the broker to redeliver when it fails.
	     Set a max redelivery count and a DMQ on q1 in the broker. -->
	<flow name="orderProcess">
		<solace-tracing:listener doc:name="On New Message q1" config-ref="Solace_Tracing_Config"
			queueName="q1"
			serviceName="mule-process"
			spanName="q1 receive" />
		<logger level="INFO" doc:name="PROCESS in"
			message='#["PROCESS in (" ++ (attributes.traceContextSource default "") ++ "): " ++ (attributes.traceparent default "")]' />

		<solace-tracing:publish doc:name="Publish order/processed" config-ref="Solace_Tracing_Config"
			destination="order/processed"
			serviceName="mule-process"
			spanName="order/processed send"
			traceparent="#[attributes.traceparent]"
			tracestate="#[attributes.tracestate]"
			target="outTrace" />
		<logger level="INFO" doc:name="PROCESS out" message='#["PROCESS out: " ++ write(vars.outTrace, "application/json")]' />
	</flow>
</mule>
